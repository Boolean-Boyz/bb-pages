   "source": "<style>\n#fopl-gameContainer {\n  width: 100%;\n  height: 70vh;\n  position: relative;\n  background: #000;\n}\n</style>\n\n<div id=\"fopl-gameContainer\"></div>\n\n<script type=\"module\">\nimport Game from \"/assets/js/GameEnginev1.1/essentials/Game.js\";\nimport GameControl from \"/assets/js/GameEnginev1.1/essentials/GameControl.js\";\nimport GameLevelFopl0Welcome from \"/assets/js/projects/fopl-pathway-game/levels/GameLevelFopl0Welcome.js\";\nimport GameLevelFopl1Library from \"/assets/js/projects/fopl-pathway-game/levels/GameLevelFopl1Library.js\";\nimport { pythonURI, javaURI, fetchOptions } from \"/assets/js/api/config.js\";\n\nconst environment = {\n    path: \"\",\n    pythonURI: pythonURI,\n    javaURI: javaURI,\n    fetchOptions: fetchOptions,\n    gameContainer: document.getElementById(\"fopl-gameContainer\"),\n    gameLevelClasses: [GameLevelFopl0Welcome, GameLevelFopl1Library]\n};\n\nGame.main(environment, GameControl);\n</script>"
